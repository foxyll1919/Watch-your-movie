# Copy to backend/.env and fill in. backend/.env is gitignored — never commit it.
TMDB_API_KEY=
# Comma-separated browser origins allowed to call this API. The defaults cover
# the Vite dev server and `vite preview`; add your deployed origin here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173